CLOUDRESEARCH_TERMINATE_URL=https://connect.cloudresearch.com/participant/project/TERMINATE_URL
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
NODE_ENV=development
