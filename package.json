{
  "name": "middle-data-survey",
  "version": "1.0.0",
  "description": "Survey experiment website for data sharing preferences research",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "bash -c 'set -a && [ -f .env ] && source .env; set +a && node server/index.js'",
    "dev": "bash -c 'set -a && [ -f .env ] && source .env; set +a && node server/index.js'",
    "migrate": "bash -c 'set -a && [ -f .env ] && source .env; set +a && node server/migrate.js'",
    "build:css": "tailwindcss -i ./public/styles.src.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./public/styles.src.css -o ./public/styles.css --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.4"
  }
}
